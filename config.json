    //        // Answer: udp is better, 
    //        // reason: the inbounds "allowedNetwork": "tcp", has already stopped the DNS Amplification Attack, that is, we can't use "allowedNetwork": "udp" in that settings.
    //        // 原因: 在入站中 "allowedNetwork": "tcp", 已经拦截了 DNS 放大攻击, 也就是，我们不能够使用 "allowedNetwork": "udp" 这个设置
    //     "rewriteNetwork": "udp",
    //     // "rewriteNetwork": "tcp",
    //     "rewriteAddress": "1.1.1.1",
    //     "rewritePort": 53,
    //     "userLevel": 0
    //     // Per-query rules: return an error code, or pass through untouched
    //     // 按查询设置规则：直接返回错误码，或原样放行
    //     // "rules": [
    //     //   {
    //     //     // Reply REFUSED (rCode 5) for example.com / 对 example.com 返回 REFUSED（rCode 5）
    //     //     "action": "return",
    //     //     "rCode": 5,
    //     //     "domain": ["domain:example.com"]
    //     //   },
    //     //   {
    //     //     // Pass HTTPS records (qType 65) for non-China domains straight through
    //     //     // 非中国域名的 HTTPS 记录（qType 65）直接放行
    //     //     "action": "direct",
    //     //     "qType": 65,
    //     //     "domain": ["geosite:geolocation-!cn"]
    //     //   }
    //     // ]
    //   }
    // },
    //  example 1 (a shorter setting case)
    // {
    //   "tag": "dns-out",
    //   "protocol": "dns",
    //   "settings": {
    //     "rewriteNetwork": "udp",
    //     "rewriteAddress": "1.1.1.1",
    //     "rewritePort": 53,
    //     "userLevel": 0
    //   }
    // },
    // example 2 (deprecated)
    // {
    //   "tag": "dns-out",
    //   "protocol": "dns",
    //   "settings": {
    //     "network": "tcp",
    //     "address": "1.0.0.1",
    //     "port": 53,
    //     "nonIPQuery": "drop",
    //     "blockTypes": []
    //   },
    //   "proxySettings": {
    //     "tag": "direct"
    //   },
    //   "streamSettings": {
    //     "sockopt": {
    //       "mark": 2
    //     }
    //   }
    // },

    // vnext configuration
      // Chain to another VLESS server for Gemini / DeepMind
      // 把 Gemini / DeepMind 流量转发到另一台 VLESS 服务器（链式代理）
      // Note: certificates, rejectUnknownSni, sniffing and tcpSettings below are server/inbound options;
      // a client outbound doesn't need them
      // 注意：下面的 certificates、rejectUnknownSni、sniffing、tcpSettings 属于服务端/入站选项，
      // 客户端出站不需要
    //  vnext example_1
    // {
    //   "tag": "vnext",
    //   "protocol": "vless",
    //   "settings": {
    //       "vnext": [
    //         {
    //           "address": "chain.example.com",  // important: input your next node server domain name
    //           "port": 443,
    //           "users": [
    //             {
    //               "id": "your_uuid", // important: input your next node server UUID
    //               "encryption": "none",
    //               "flow": "xtls-rprx-vision",
    //               "level": 0
    //             }
    //           ]
    //         }
    //       ]
    //   },
    //   "streamSettings": {
    //       "network": "tcp",
    //       "security": "tls",
    //       "tlsSettings": {
    //         "rejectUnknownSni": true,
    //         "minVersion": "1.2",
    //         "serverName": "chain.example.com", // important: input your next node server domain name
    //         "alpn": [
    //           "h2",
    //           "http/1.1"
    //         ],
    //         "allowInsecure": false,
    //         "disableSystemRoot": false,
    //         "certificates": [
    //           {
    //             "ocspStapling": 3600,
    //             "oneTimeLoading": false,
    //             "usage": "encipherment",
    //             "certificateFile": "/usr/local/etc/xray/fullchain.pem",
    //             "keyFile": "/usr/local/etc/xray/privkey.pem"
    //           }
    //         ]
    //       }
    //   },
    //   "tcpSettings": {
    //     "acceptProxyProtocol": false
    //   },
    //   "sniffing": {
    //     "enabled": true,
    //     "destOverride": ["http", "tls", "quic"]
    //   }
    // },
    //  vnext example 2_under verification
    // {
    //   "tag": "vnext",                      // 如果路由规则引用了这个名字就保留，否则可以改成更直观的 chain-out
    //   "protocol": "vless",
    //   "settings": {
    //     "address": "chain.example.com",   // 下一跳的域名
    //     "port": 443,
    //     "id": "your_uuid",                // 下一跳的 UUID
    //     "encryption": "none",
    //     "flow": "xtls-rprx-vision",
    //     "level": 0
    //   },
    //   "streamSettings": {
    //     "network": "raw",
    //     "security": "tls",
    //     "tlsSettings": {
    //       "serverName": "chain.example.com",
    //       "fingerprint": "chrome",
    //       "minVersion": "1.2"
    //     }
    //   }
    // },

    // Cloudflare WARP via WireGuard: gives the server a Cloudflare exit IP
    // 通过 WireGuard 连接 Cloudflare WARP：让服务器使用 Cloudflare 的出口 IP
    // {
    //   "protocol": "wireguard",
    //   "settings": {
    //     // WARP account private key / WARP 账户私钥
    //     "secretKey": "YOUR_WARP_PRIVATE_KEY",
    //     // Tunnel IPs assigned by WARP / WARP 分配的隧道内 IP
    //     "address": [
    //       "172.16.0.2/32",
    //       "YOUR_WARP_IPV6/128"
    //     ],
    //     "peers": [
    //       {
    //         // WARP endpoint / WARP 接入点
    //         "endpoint": "162.159.192.1:2408",
    //         // Cloudflare's public key / Cloudflare 的公钥
    //         "publicKey": "bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=",
    //         // Send all IPv4 and IPv6 through the tunnel / 所有 IPv4 和 IPv6 都走隧道
    //         "allowedIPs": [
    //           "0.0.0.0/0",
    //           "::/0"
    //         ]
    //       }
    //     ],
    //     // Use the kernel TUN when available / 可用时使用系统内核 TUN
    //     "noKernelTun": false,
    //     // Tunnel MTU / 隧道 MTU
    //     // "mtu": 1280,
    //     "mtu": 1420,
    //     // WARP client ID bytes / WARP 客户端标识字节
    //     "reserved":[ 0, 0, 0 ],
    //     // DNS servers used inside the tunnel (check that your Xray version supports this key)
    //     // 隧道内使用的 DNS（请确认你的 Xray 版本支持此字段）
    //     "remoteDNS": [
    //       "1.1.1.1",
    //       "1.0.0.1",
    //       "2606:4700:4700::1111",
    //       "2606:4700:4700::1001"
    //     ]
    //     // Force IPv6 first, then IPv4 / 强制优先 IPv6，其次 IPv4
    //     // "domainStrategy": "ForceIPv6v4"
    //   },
    //   "tag": "warp"
    // }
  ],

  // Routing: decides which outbound each connection uses
  // 路由：决定每条连接走哪个出站
  "routing": {
    // Match domain rules first; if none match, resolve to IP and match IP rules
    // 先按域名规则匹配；都不命中时再解析成 IP，按 IP 规则匹配
    "domainStrategy": "IPIfNonMatch",
    // Domain matching algorithm; hybrid is faster and uses less memory
    // 域名匹配算法；hybrid 更快、更省内存
    "domainMatcher": "hybrid",
    // Rules are checked top to bottom; the first match wins
    // 规则从上往下检查，命中第一条即生效
    "rules": [
        // 如果我只添加 模块 (module) inbounds 中对象 (object) "tag": "sniproxy-in" 的内容, 而不添加模块 (module) routing 和 outbounds 的内容, 那么 routing 规则和对应的 "outboundTag": "dns-out" object 可以不要吗？也能达到 DNS proxy 的目标？
      // {
      //   "type": "field",
      //   "inboundTag": ["sniproxy-in"],
      //   "outboundTag": "dns-out" // optional: "outboundTag": "direct"
      // },
      // //   "type": "field",
      // //   "inboundTag": ["sniproxy-in"],
      // //   "port": 53, // do we need this?
      // //   "outboundTag": "direct"
      // // },

      // Send API traffic to the API service
      // API 入站的流量交给 API 服务
      {
        "type": "field",
        "inboundTag": ["api"],
        "outboundTag": "api"
      },
      // Block BitTorrent
      // 屏蔽 BT 下载
      {
        "type": "field",
        "protocol": ["bittorrent"],
        "outboundTag": "block"
      },
      // Block private / LAN domains
      // 屏蔽私有 / 局域网域名
      {
        "type": "field",
        "domain": ["geosite:private"],
        "outboundTag": "block"
      },
      // Block Steam download CDN (saves bandwidth)
      // 屏蔽 Steam 下载 CDN（节省流量）
      {
        "type": "field",
        "domain": ["domain:steamcontent.com"],
        "outboundTag": "block"
      },
      // Block Adobe license activation servers
      // 屏蔽 Adobe 激活验证服务器
      {
        "type": "field",
        "domain": ["geosite:adobe-activation"],
        "outboundTag": "block"
      },
      // Send Gemini / DeepMind to the IPv4-only outbound
      // Gemini / DeepMind 走只用 IPv4 的出站
        // for server region that gemini is not available, mark the following object
      {
        "type": "field",
        "domain": [
          "geosite:google-gemini",
          "geosite:google-deepmind"
        ],
        "outboundTag": "google-deepmind"
      },
      // Send streaming / AI sites through WARP
      // 流媒体和 AI 网站走 WARP
        // for server region that gemini is not available, unmark the following object items relate to google-deepmind
      // {
      //   "type": "field",
      //   "domain": [
      //     "domain:mgmplus.com",
      //     "domain:philo.com",
      //     "domain:starz.com",
      //     "geosite:disney",
      //     for servers that gemini doesn't support the region
      //     // "geosite:google-deepmind",
      //     // "geosite:google-gemini",
      //     for servers that HBO Max buffers a lot
      //     // "geosite:hbomax",
      //     for servers that netflix thinks you using vpn
      //     // "geosite:netflix",
      //     "geosite:google",
      //     "geosite:reddit"
      //   ],
      //   "outboundTag": "warp"
        // can change to vnext for sending these requests to next node server
      //   "outboundTag": "vnext"
      // },

      // Block private / LAN IPs (prevents access to the server's internal network)
      // 屏蔽私有 / 局域网 IP（防止访问服务器内网）
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "block"
      },
      // Block China IPs (China sites should be accessed directly, not via this server)
      // 屏蔽中国 IP（国内网站应直连，不经过这台服务器）
      {
        "type": "field",
        "ip": ["geoip:cn"],
        "outboundTag": "block"
      },
      // Everything else goes direct
      // 其余所有流量直连
      {
        "type": "field",
        "network": "tcp, udp",
        "outboundTag": "direct"
      }
    ],
    // Load balancers (none configured)
    // 负载均衡器（未配置）
    "balancers": [
    ]
  },

  // Policy: timeouts, buffers and stats per user level
  // 策略：按用户等级设置超时、缓冲和统计
  "policy": {
    "levels": {
      // Applies to users with "level": 0
      // 作用于 "level": 0 的用户
      "0": {
        // Handshake timeout (s) / 握手超时（秒）
        "handshake": 4,
        // Close idle connections after 300 s / 连接空闲 300 秒后断开
        "connIdle": 300,
        // Timeout after downlink closes (s) / 下行关闭后的等待时间（秒）
        "uplinkOnly": 2,
        // Timeout after uplink closes (s) / 上行关闭后的等待时间（秒）
        "downlinkOnly": 5,
        // Per-user upload / download stats / 按用户统计上传 / 下载流量
        "statsUserUplink": true,
        "statsUserDownlink": true,
        // Per-connection buffer size (KB) / 每条连接的缓冲区大小（KB）
        "bufferSize": 10240
      }
    },
    // Per-inbound / per-outbound traffic stats
    // 按入站 / 出站统计流量
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },

  // Inbounds: where the server accepts connections
  // 入站：服务器接收连接的方式
  "inbounds": [
    // Main VLESS + XTLS Vision + TLS inbound on port 443
    // 主入站：VLESS + XTLS Vision + TLS，监听 443 端口
    {
      "tag": "A0",
      // Listen on all IPv4 addresses / 监听所有 IPv4 地址
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        // User list; email is only a label for stats / 用户列表；email 只是统计用的标识
        "clients": [
          {
            "email": "e0@yahoo.com",
            // Input your UUID here / 在此填入你的 UUID
            "id": "your_uuid1", // important: input your UUID here
            // XTLS Vision flow control / XTLS Vision 流控
            "flow": "xtls-rprx-vision",
            "level": 0
          },
          {
            "email": "e1@yahoo.com",
            "id": "your_uuid2", // important: input your UUID here
            "flow": "xtls-rprx-vision",
            "level": 0
          },
          {
            "email": "e2@yahoo.com",
            "id": "your_uuid3", // important: input your UUID here
            "flow": "xtls-rprx-vision",
            "level": 0
          }
        ],
        // VLESS requires "none" / VLESS 必须为 "none"
        "decryption": "none",
        // Non-VLESS traffic (e.g. browsers, probes) is passed to a local web server
        // 非 VLESS 流量（如浏览器访问、主动探测）转交给本地网站
        "fallbacks": [
          {
            // HTTP/1.1 -> port 23332, with PROXY protocol v2 to pass the real client IP
            // HTTP/1.1 -> 23332 端口，附带 PROXY protocol v2 传递真实客户端 IP
            "dest": 23332,
            "xver": 2
          },
          {
            // HTTP/2 -> port 23333 / HTTP/2 -> 23333 端口
            "alpn": "h2",
            "dest": 23333,
            "xver": 2
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          // Reject handshakes whose SNI doesn't match the certificate (anti-probing)
          // SNI 与证书不匹配时拒绝握手（防探测）
          "rejectUnknownSni": true,
          // Minimum TLS version / 最低 TLS 版本
          "minVersion": "1.2",
          "serverName": "your.domain.com", // important: input your domain
          // Protocols offered in the TLS handshake / TLS 握手时协商的协议
          "alpn": [
            "h2",
            "http/1.1"
          ],
          // Client-side options; no effect on a server inbound
          // 客户端选项，在服务端入站中无作用
          "allowInsecure": false,
          "disableSystemRoot": false,
          "certificates": [
            {
              // Refresh OCSP stapling every 3600 s / 每 3600 秒刷新 OCSP 装订
              "ocspStapling": 3600,
              // Keep watching the cert files so renewals take effect without restart
              // 持续监视证书文件，续签后无需重启即可生效
              "oneTimeLoading": false,
              // Used for TLS encryption / 用于 TLS 加密
              "usage": "encipherment",
              "certificateFile": "/usr/local/etc/xray/fullchain.pem", // important: input the correct path for your 'fullchain.pem' certificate
              "keyFile": "/usr/local/etc/xray/privkey.pem"  // important: input the correct path for your 'privkey.pem' key
            }
          ]
        }
      },
      // Whether to accept PROXY protocol from a front proxy (e.g. Nginx/HAProxy)
      // Note: to take effect it should sit inside streamSettings; false is the default anyway
      // 是否接收前置代理（如 Nginx/HAProxy）发来的 PROXY protocol
      // 注意：要生效需放在 streamSettings 里面；false 本来就是默认值
      "tcpSettings": {
        "acceptProxyProtocol": false
      },
      // Sniff the real domain from traffic so domain-based routing rules work
      // 从流量中嗅探真实域名，让基于域名的路由规则生效
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    },

    // Public DNS relay on port 53 (TCP only), sent to dns-out via routing
    // 对外的 DNS 中转，监听 53 端口（仅 TCP），经路由交给 dns-out
    // Tunnel (dokodemo-door) module detailed settings
      // url: https://xtls.github.io/config/inbounds/tunnel.html
    // {
    //   "tag": "sniproxy-in",
    //   "listen": "0.0.0.0",
    //   "port": 53,
    //   "protocol": "tunnel",
    //   "settings": {
    //     "allowedNetwork": "tcp",
    //     "rewriteAddress": "127.0.0.1",
    //       // 如果我改成 "rewriteAddress": "1.1.1.1", 那么 routing 规则和对应的 outbound DNS "tag": "dns-out" object 可以不要吗？也能达到 DNS proxy 的目标？
    //     // "rewriteAddress": "1.1.1.1",
    //     "rewritePort": 53,
    //     // Map different listening ports to different targets
    //     // 把不同监听端口映射到不同目标
    //     "portMap": {
    //       "5555": "1.1.1.1:7777",
    //       "5556": ":8888", // overrides port only
    //       "5557": "example.com:" // overrides address only
    //     },
    //     "followRedirect": false,
    //     "userLevel": 0
    //   }
    // },
    // Tunnel (dokodemo-door) module brief settings
    // {
    //   "tag": "sniproxy-in",
    //   "listen": "0.0.0.0", 
    //   "port": 53,
    //   "protocol": "tunnel",
    //   "settings": {
    //     "allowedNetwork": "tcp",
    //     "rewriteAddress": "127.0.0.1",
    //     "rewritePort": 53,
    //     "followRedirect": false,
    //     "userLevel": 0
    //   }
    // },
    // Tunnel (dokodemo-door) module settings 2_older version (deprecated)
    // {
    //   "tag": "sniproxy-in",
    //   "protocol": "dokodemo-door",
    //   "address": "0.0.0.0",
    //   "port": 53,
    //   "settings": {
    //     "address": "127.0.0.1",
    //     "port": 53,
    //     "network": "tcp",
    //     "followRedirect": false
    //   },  
    //   "sniffing": {
    //     "enabled": true,
    //     "destOverride": ["http", "tls", "quic"]
    //   }
    // },

    // xray api: detailed vesion
    // Local-only API entry for `xray api` commands
    // 仅本机可访问的 API 入口，供 `xray api` 命令使用
    // {
    //   "tag": "api",
    //   "listen": "127.0.0.1",
    //   "address": "0.0.0.0",
    //   "port": 10085,
    //   "port": 53,
    //   tunnel = port forwarding (formerly dokodemo-door)
    //   tunnel = 端口转发（原 dokodemo-door）
    //   "protocol": "tunnel",
    //   "settings": {
    //     udp here is not safe, DO NOT use udp
    //     "allowedNetwork": "tcp, udp",
    //     "rewriteAddress": "127.0.0.1"
    //     "rewritePort": 53,
    //     "portMap": {
    //       "5555": "1.1.1.1:7777",
    //       "5556": ":8888", // overrides port only
    //       "5557": "example.com:" // overrides address only
    //     },
    //     "followRedirect": false,
    //     "userLevel": 0
    //   }
    // }
    // xray api: brief version
    {
      "tag": "api",
      "listen": "127.0.0.1",
      "port": 10085,
      "protocol": "tunnel",
      "settings": {
        "rewriteAddress": "127.0.0.1"
      }
    }
    // xray api: older version (deprecated)
    // Old-style API inbound using the dokodemo-door name
    // 旧写法：使用 dokodemo-door 名称的 API 入站
    // {
    //   "tag": "api",
    //   "listen": "127.0.0.1",
    //   "port": 10085,
    //   "protocol": "dokodemo-door",
    //   "settings": {
    //     "address": "127.0.0.1"
    //   }
    // }
  ],

  // Enable the stats module (required by StatsService and the stats* options in policy)
  // 启用统计模块（StatsService 和 policy 中的 stats* 选项都依赖它）
  "stats": {}
}
