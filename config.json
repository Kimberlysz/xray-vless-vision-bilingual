{
  // Logging settings
  // 日志设置
  "log": {
    // Access log path: records every connection
    // 访问日志路径：记录每一条连接
    "access": "/var/log/xray/access.log",
    // Error log path: records runtime errors and warnings
    // 错误日志路径：记录运行错误和警告
    "error": "/var/log/xray/error.log",
    // Log level: debug / info / warning / error / none
    // 日志级别：debug / info / warning / error / none
    "loglevel": "warning",
    // Whether to log DNS queries
    // 是否记录 DNS 查询日志
    "dnsLog": false
  },

  // API: lets external tools (xray api) query stats and manage users at runtime
  // API：允许外部工具（xray api 命令）在运行时查询流量统计、管理用户
  "api": {
    // Outbound tag for API traffic; matched by the "api" routing rule below
    // API 流量的出站标签，由下方 routing 中的 api 规则匹配
    "tag": "api",
    "services": [
      // Traffic statistics / 流量统计
      "StatsService",
      // Add or remove inbounds, outbounds and users on the fly / 动态增删入站、出站和用户
      "HandlerService",
      // Restart logger, e.g. after log rotation / 重启日志模块（如日志轮转后）
      "LoggerService"
    ]
  },

  // Built-in DNS module: used for routing decisions and by outbounds that resolve domains
  // 内置 DNS 模块：供路由判断和出站解析域名时使用
  "dns": {
    // Server list, matched top to bottom; entries with "domains" are tried first for matching domains
    // 服务器列表，从上往下匹配；带 "domains" 的条目优先用于对应域名
    "servers": [
      // Forward DNS queries to another server over TCP
      // 通过 TCP 把 DNS 查询发送到指定 IP 服务器进行查询并返回
      // {
      //   "address": "tcp://38.244.11.21:53",  // important: input your DNS proxy server correct IP
      //   // DoH use port 443
      //   // "port": 53
      //   "domains": [
      //     "domain:mgmplus.com",
      //     "domain:philo.com",
      //     "domain:starz.com",
      //     "geosite:disney",
      //     // "geosite:google-deepmind",
      //     // "geosite:google-gemini",
      //     "geosite:google",
      //     "geosite:reddit"
      //   ],
      //   "skipFallback": true
      // },

      // Use only IPv4 to return
      // Resolve Google Gemini / DeepMind via Google DoH, return IPv4 only
      // 用 Google DoH 解析 Gemini / DeepMind 域名，只返回 IPv4
        // for server region that gemini is not available, mark the following object
      {
        "address": "https://dns.google/dns-query",
        "domains": [
          "geosite:google-deepmind",
          "geosite:google-gemini"
        ],
        // Do not use this server for domains outside the list above
        // 不在上面列表中的域名，不会用到这台服务器
        "skipFallback": true,
        "queryStrategy": "UseIPv4"
      },
      // Resolve Perplexity / Netflix / bgp.he.net via Cloudflare DoH, IPv4 only
      // 用 Cloudflare DoH 解析 Perplexity / Netflix / bgp.he.net，只返回 IPv4
      {
        "address": "https://cloudflare-dns.com/dns-query",
        "domains": [
          "geosite:perplexity",
          "geosite:netflix",
          "domain:bgp.he.net"
        ],
        "skipFallback": true,
        "queryStrategy": "UseIPv4"
      },
      // Resolve OpenAI via Cloudflare DoH, IPv6 only
      // 用 Cloudflare DoH 解析 OpenAI，只返回 IPv6
      {
        "address": "https://cloudflare-dns.com/dns-query",
        "domains": ["geosite:openai"],
        "skipFallback": true,
        "queryStrategy": "UseIPv6"
      },
      // Non-China domains use the system resolver; accept only non-China IPs in the answer
      // 非中国域名走系统 DNS；只接受非中国 IP 的解析结果
      {
        "address": "localhost",
        "domains": ["geosite:geolocation-!cn"],
        "expectIPs": ["geoip:!cn"]
      },
      // China domains use AliDNS; accept only China IPs in the answer
      // 中国域名走阿里 DNS；只接受中国 IP 的解析结果
      {
        "address": "223.5.5.5",
        "domains": ["geosite:cn"],
        "expectIPs": ["geoip:cn"]
      },
      // Fallback servers for everything else, tried in order
      // 其余域名的兜底服务器，按顺序尝试
      // Cloudflare plain DNS (UDP) / Cloudflare 普通 DNS（UDP）
      "1.0.0.1",
      // Cloudflare DoH / Cloudflare DNS over HTTPS
      "https://cloudflare-dns.com/dns-query",
      // Google plain DNS (UDP) / Google 普通 DNS（UDP）
      "8.8.8.8",
      // Google DoH / Google DNS over HTTPS
      "https://dns.google/dns-query",
      // Google DNS over TLS (DoT, port 853) / Google DNS over TLS（DoT，853 端口）
      "tls://dns.google",
      // cisco DNS
      // Cisco OpenDNS over TCP on alternate port 443 / Cisco OpenDNS，走 TCP 443 备用端口
      "tcp://208.67.222.222:443",
      // System resolver as the last resort / 最后兜底：系统 DNS
      "localhost"
    ],
    // Client IP sent via EDNS Client Subnet, helps CDNs return nearby nodes
    // 通过 EDNS Client Subnet 告知 DNS 服务器客户端 IP，便于 CDN 返回就近节点
    // "clientIp": "1.2.3.4",
    // Default query type: UseIP = both IPv4 and IPv6
    // 默认查询类型：UseIP = 同时查 IPv4 和 IPv6
    "queryStrategy": "UseIP",
    // Keep DNS cache enabled
    // 保留 DNS 缓存
    "disableCache": false,
    // Whether to return expired cache entries while refreshing in the background
    // 是否在后台刷新的同时返回已过期的缓存记录
    "serveStale": false,
    // How long expired entries may still be served (only matters when serveStale is true)
    // 过期记录还能被使用多久（仅在 serveStale 为 true 时生效）
    "serveExpiredTTL": 0,
    // Allow falling back to other servers when a query fails
    // 查询失败时允许回退到其他服务器
    "disableFallback": false,
    // Allow fallback even when the domain matched a server's "domains" list
    // 即使域名命中了某台服务器的 "domains" 列表，也允许回退
    "disableFallbackIfMatch": false,
    // Query servers one at a time instead of all at once
    // 逐个查询服务器，而不是同时并发查询
    "enableParallelQuery": false,
    // Ignore the system hosts file (/etc/hosts)
    // 不读取系统 hosts 文件（/etc/hosts）
    "useSystemHosts": false,
    // Inbound tag for DNS queries made by Xray itself; can be matched in routing
    // Xray 自身发出的 DNS 查询所带的入站标签，可在路由中匹配
    "tag": "dns_inbound"
  },

  // Outbounds: where traffic leaves the server
  // 出站：流量从服务器发出去的方式
  "outbounds": [
    // {
    //   "protocol": "freedom",
    //   "tag": "direct",
    //   "settings": {
    //     "domainStrategy": "UseIPv4v6"
    //   }
    // },

    // Direct connection; resolve domains with the built-in DNS, prefer IPv4 then IPv6
    // 直连出站；用内置 DNS 解析域名，优先 IPv4、其次 IPv6
    {
      "protocol": "freedom",
      "tag": "direct",
      "streamSettings": {
        // "sockopt": { "domainStrategy": "UseIPv4" }
        "sockopt": { "domainStrategy": "UseIPv4v6" }
      }
    },
    // {
    //   "protocol": "freedom",
    //   "tag": "google-deepmind",
    //   "settings": {
    //     "domainStrategy": "ForceIPv4"
    //   }
    // },

    // Direct connection for Gemini / DeepMind, IPv4 only; fails instead of falling back if no IPv4
    // Gemini / DeepMind 专用直连，只用 IPv4；没有 IPv4 结果时直接失败，不回退
      // for server region that gemini is not available, mark the following object
    {
      "protocol": "freedom",
      "tag": "google-deepmind",
      "streamSettings": {
        "sockopt": { "domainStrategy": "ForceIPv4" }
      }
    },
    // Blackhole: silently drop traffic
    // 黑洞：直接丢弃流量
    {
      "protocol": "blackhole",
      "tag": "block"
    }

    // DNS outbound: intercepts DNS traffic and hands it to Xray's DNS module
    // DNS 出站：拦截 DNS 流量，交给 Xray 内置 DNS 模块处理
    // example 1
    // {
    //   "tag": "dns-out",
    //   "protocol": "dns",
    //   "settings": {
    //     // Override protocol / address / port of the upstream DNS server
    //     // 改写上游 DNS 服务器的协议 / 地址 / 端口
